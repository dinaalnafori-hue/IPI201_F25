<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- الألوان الأساسية: تدرجات أخضر هادي -->
    <Color x:Key="PrimaryColor">#2E7D6B</Color>
    <Color x:Key="PrimaryDarkColor">#1F5F50</Color>
    <Color x:Key="PrimaryLightColor">#6FB7A3</Color>
    <Color x:Key="AccentColor">#A8D5C5</Color>
    <Color x:Key="BackgroundColor">#F2F8F6</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="TextColor">#24382F</Color>
    <Color x:Key="MutedTextColor">#6B8179</Color>
    <Color x:Key="BorderColor">#D5E5DF</Color>
    <Color x:Key="DangerColor">#C95A5A</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

    <!-- تدرج القائمة الجانبية -->
    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1F5F50" Offset="0"/>
        <GradientStop Color="#2E7D6B" Offset="1"/>
    </LinearGradientBrush>

    <!-- تدرج زر الدخول والأزرار الرئيسية -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3C9A84" Offset="0"/>
        <GradientStop Color="#2E7D6B" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
