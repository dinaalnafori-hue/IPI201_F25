<Window x:Class="TechServices.CreateCustomerAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TechServices"
        mc:Ignorable="d"
        Title="CreateCustomerAccountWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="1" Background="{StaticResource SidebarBrush}">
            <StackPanel VerticalAlignment="Center" Margin="40">
                <TextBlock Text="👤" FontSize="64" HorizontalAlignment="Center"/>
                <TextBlock Text=" انشاء حساب عميل" FontSize="26" FontWeight="Bold"
              Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,8"/>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" FlowDirection="RightToLeft" >
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="48,0"  FlowDirection="LeftToRight">
                <TextBlock Text="انشاء الحساب " FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
           Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,0,0,24"/>

                <TextBlock Text="اسم المستخدم"  HorizontalAlignment="Right" Margin="0,0,0,6"/>
                <TextBox x:Name="UsernameBox" Margin="0,0,0,14"/>

                <TextBlock Text="رقم الهاتف "  HorizontalAlignment="Right" Margin="0,0,0,6"/>
                <TextBox x:Name="Phone" Margin="0,0,0,14"/>

                <TextBlock Text="البريد الالكتروني"  HorizontalAlignment="Right" Margin="0,0,0,6"/>
                <TextBox x:Name="Email" Margin="0,0,0,14"/>

                <TextBlock Text="العنوان"  HorizontalAlignment="Right" Margin="0,0,0,6"/>
                <TextBox x:Name="Address" Margin="0,0,0,14"/>

                <TextBlock Text="كلمة السر"  HorizontalAlignment="Right" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordInput" Margin="0,0,0,14"/>
                <TextBox x:Name="PasswordInputVisible" Margin="0,0,0,14" Visibility="Collapsed"/>
                <CheckBox x:Name="chkShowPassword" Content="اظهار كلمة السر" HorizontalAlignment="Right" Margin="0,0,0,20" Checked="ShowPassword_Changed" Unchecked="ShowPassword_Changed"/>

                <TextBlock Text="تأكيد كلمة السر"  HorizontalAlignment="Right" Margin="0,0,0,6"/>
                <PasswordBox x:Name="ConfirmPassword" Margin="0,0,0,14"/>
                <TextBox x:Name="ConfirmPasswordInputVisible" Margin="0,0,0,14" Visibility="Collapsed"/>
                <CheckBox x:Name="chkShowConfirmPassword" Content="اظهار تأكيد كلمة السر" HorizontalAlignment="Right" Margin="0,0,0,14" Checked="ShowConfirmPassword_Changed" Unchecked="ShowConfirmPassword_Changed"/>

                <TextBlock x:Name="InfoText" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,10,0,10"/>

                <Button Content="انشاء" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="CreateAccount_Click" Margin="0,4"/>
                <Button Content="رجوع" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Back_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
